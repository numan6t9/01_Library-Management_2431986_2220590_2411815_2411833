<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="supplierPaymentsMainPane" prefHeight="870.0" prefWidth="802.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="abdullahalnuman.SupplierPaymentsViewController">
   <children>
      <Label alignment="CENTER" prefHeight="56.0" prefWidth="802.0" style="-fx-background-color: grey;" text="Supplier Payments">
         <font>
            <Font name="DejaVu Serif Bold" size="17.0" />
         </font>
      </Label>
      <Label layoutX="39.0" layoutY="116.0" text="Enter Invoice Number:" />
      <TextField fx:id="enterInvoiceNumber" layoutX="203.0" layoutY="112.0" />
      <Label layoutX="444.0" layoutY="116.0" text="Enter Supplier ID:" />
      <TextField fx:id="enterSupplierId" layoutX="585.0" layoutY="112.0" />
      <Button layoutX="301.0" layoutY="243.0" mnemonicParsing="false" onAction="#searchUnpaidSupplierAndLoadTable" text="Search Unpaid Supplier Table " />
      <TableView fx:id="TableView" layoutX="212.0" layoutY="331.0" prefHeight="245.0" prefWidth="364.0">
        <columns>
          <TableColumn fx:id="invoiceIdTableView" prefWidth="181.0" text="Invoice ID" />
          <TableColumn fx:id="supplierIdTableView" prefWidth="182.0" text="Supplier ID" />
        </columns>
      </TableView>
      <Label layoutX="137.0" layoutY="661.0" text="Selecte an Invoice ID from the list" />
      <TextField fx:id="selectInvoiceFromListForProccedPayment" layoutX="423.0" layoutY="657.0" />
      <Button layoutX="294.0" layoutY="767.0" mnemonicParsing="false" onAction="#paySupplierButton" prefHeight="26.0" prefWidth="205.0" text="PaySupplier" />
      <Button layoutX="21.0" layoutY="15.0" mnemonicParsing="false" onAction="#backButton" prefHeight="26.0" prefWidth="99.0" text="Back" />
   </children>
</AnchorPane>
