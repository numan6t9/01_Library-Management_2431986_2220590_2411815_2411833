<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="inquiryMainPane" prefHeight="863.0" prefWidth="711.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="abdullahalnuman.InquiryViewController">
   <children>
      <Label alignment="CENTER" prefHeight="59.0" prefWidth="715.0" style="-fx-background-color: grey;" text="Membership Inquiry">
         <font>
            <Font name="FreeSans Bold" size="21.0" />
         </font>
      </Label>
      <Label layoutX="56.0" layoutY="103.0" text="Enter MemberID/Visitor Pass" />
      <TextField fx:id="enterMemberIdorVisitorPass" layoutX="257.0" layoutY="99.0" />
      <Button layoutX="497.0" layoutY="99.0" mnemonicParsing="false" onAction="#searchMemberOrVisitorButton" text="Search Member/Visitor" />
      <Label layoutX="56.0" layoutY="173.0" text="Membership/Visitor Status:" />
      <Label fx:id="showMemberOrVisitorStatus" layoutX="244.0" layoutY="173.0" style="-fx-background-color: green;" text="Show status" textFill="WHITE" />
      <Label layoutX="60.0" layoutY="233.0" text="Inquiry About" />
      <TextField fx:id="inquiryDetails" layoutX="184.0" layoutY="229.0" />
      <Button layoutX="516.0" layoutY="229.0" mnemonicParsing="false" onAction="#saveInquiryButton" text="Save Inquiry Record" />
      <Button layoutX="24.0" layoutY="17.0" mnemonicParsing="false" onAction="#backButton" text="Back" />
      <Label fx:id="showInquirySavedText" alignment="CENTER" layoutX="198.0" layoutY="307.0" prefHeight="59.0" prefWidth="279.0" style="-fx-background-color: green;" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
