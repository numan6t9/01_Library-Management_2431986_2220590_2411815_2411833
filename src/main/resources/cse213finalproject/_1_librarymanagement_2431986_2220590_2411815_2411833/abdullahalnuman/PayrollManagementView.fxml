            <Font name="System Bold" size="15.0" />
         </font>
      </Label>
      <Label layoutX="22.0" layoutY="133.0" text="Select payroll Period" />
      <DatePicker fx:id="fromPayrollPeriod" layoutX="171.0" layoutY="129.0" />
      <Label layoutX="388.0" layoutY="133.0" text="To" />
      <DatePicker fx:id="toPayrollPeriod" layoutX="437.0" layoutY="129.0" />
      <Label layoutX="22.0" layoutY="180.0" text="Select Employee ID" />
      <TextField fx:id="selectEmployeeId" layoutX="171.0" layoutY="176.0" />
      <Button layoutX="360.0" layoutY="176.0" mnemonicParsing="false" onAction="#ShowMembersPayrollStatusButton" text="Show selected members payroll status" />
      <Label fx:id="showStatus" layoutX="430.0" layoutY="221.0" prefHeight="47.0" prefWidth="126.0" style="-fx-background-color: blue;" text="Show paid or unpaid" textFill="WHITE" />
      <Label layoutX="47.0" layoutY="327.0" text="Gross Salary" />
      <TextField fx:id="grossSalary" layoutX="171.0" layoutY="323.0" />
