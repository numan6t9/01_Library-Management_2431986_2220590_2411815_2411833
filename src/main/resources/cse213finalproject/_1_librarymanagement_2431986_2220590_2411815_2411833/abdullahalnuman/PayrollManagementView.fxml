      <Button layoutX="253.0" layoutY="564.0" mnemonicParsing="false" onAction="#paySalaryAndGenerateReportButton" text="Pay salary And generate Receipt" />
      <Button layoutX="33.0" layoutY="49.0" mnemonicParsing="false" onAction="#backButton" prefHeight="26.0" prefWidth="60.0" text="Back" />
