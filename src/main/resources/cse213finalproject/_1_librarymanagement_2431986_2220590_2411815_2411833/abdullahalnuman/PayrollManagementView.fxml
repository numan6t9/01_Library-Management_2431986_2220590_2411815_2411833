<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="payrollMainPane" prefHeight="869.0" prefWidth="683.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="abdullahalnuman.PayrollManagementViewController">
   <children>
      <Label layoutX="226.0" layoutY="38.0" prefHeight="47.0" prefWidth="149.0" text="Payroll Mangement">
