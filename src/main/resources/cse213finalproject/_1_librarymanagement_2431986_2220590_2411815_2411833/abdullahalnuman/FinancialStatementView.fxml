<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="803.0" prefWidth="689.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="abdullahalnuman.FinancialStatementViewController">
   <children>
      <Label layoutX="273.0" layoutY="49.0" text="Financial Statement">
         <font>
            <Font name="FreeSans Bold" size="15.0" />
         </font>
      </Label>
      <Label layoutX="59.0" layoutY="125.0" text="Select Fiscal Period" />
      <DatePicker fx:id="fiscalPeriodFrom" layoutX="193.0" layoutY="121.0" />
      <DatePicker fx:id="fiscalPeriodTo" layoutX="448.0" layoutY="121.0" />
      <Label layoutX="399.0" layoutY="125.0" text="TO" />
      <Button layoutX="273.0" layoutY="198.0" mnemonicParsing="false" onAction="#loadFinancialRecordsButton" text="Load Financial Records" />
      <TableView fx:id="financialStatementTableView" layoutX="70.0" layoutY="281.0" prefHeight="185.0" prefWidth="534.0">
        <columns>
          <TableColumn fx:id="membershipFeeTableView" prefWidth="282.0" text="Membership Fees" />
          <TableColumn fx:id="libraryExpensesTableView" prefWidth="251.0" text="Library Expenses " />
        </columns>
      </TableView>
      <Button layoutX="221.0" layoutY="532.0" mnemonicParsing="false" onAction="#calculateTotalIncomeAndExpenditureButton" text="Calculate Total Income And Expenditure" />
      <Label fx:id="showTotalIncome" layoutX="111.0" layoutY="474.0" prefHeight="18.0" prefWidth="94.0" style="-fx-background-color: green;" text="Total Income" textFill="WHITE" />
      <Label fx:id="showTotalExpenditure" layoutX="462.0" layoutY="474.0" style="-fx-background-color: red;" text="Total Expenditure" />
      <Button layoutX="181.0" layoutY="620.0" mnemonicParsing="false" onAction="#generateFinancialStatementAndExportReportButton" text="Generate financial statement And Export Report" />
   </children>
</AnchorPane>
