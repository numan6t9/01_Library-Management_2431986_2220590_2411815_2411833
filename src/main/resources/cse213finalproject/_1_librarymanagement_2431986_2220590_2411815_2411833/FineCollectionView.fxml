      <Label layoutX="55.0" layoutY="150.0" text="Enter Member ID" />
      <TextField fx:id="enterMemberId" layoutX="196.0" layoutY="146.0" />
      <Button layoutX="411.0" layoutY="146.0" mnemonicParsing="false" onAction="#searchMemberButton" text="SearchMember" />
      <TableView fx:id="fineCollectionTableView" layoutX="157.0" layoutY="209.0" prefHeight="200.0" prefWidth="287.0">
        <columns>
          <TableColumn fx:id="borrowedBookTableView" prefWidth="146.0" text="Borrowed Books" />
          <TableColumn fx:id="bookReturnDateTableView" prefWidth="143.0" text="Book Return Date" />
        </columns>
      </TableView>
      <Label layoutX="55.0" layoutY="458.0" text="Fine Per Day" />
      <TextField fx:id="finePerDay" layoutX="249.0" layoutY="454.0" />
      <Label layoutX="55.0" layoutY="531.0" text="Total overdue days" />
      <TextField fx:id="overdueDays" layoutX="249.0" layoutY="527.0" />
