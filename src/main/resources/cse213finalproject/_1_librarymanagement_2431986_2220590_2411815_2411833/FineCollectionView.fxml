<AnchorPane prefHeight="769.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="abdullahalnuman.FineCollectionViewController">
   <children>
      <Label layoutX="242.0" layoutY="55.0" text="Fine Collection">
