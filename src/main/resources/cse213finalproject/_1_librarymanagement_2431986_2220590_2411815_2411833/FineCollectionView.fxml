      </Label>
      <Label layoutX="55.0" layoutY="598.0" text="Enter Payment Information" />
      <TextField fx:id="enterPaymentInformation" layoutX="249.0" layoutY="594.0" />
      <Button layoutX="440.0" layoutY="594.0" mnemonicParsing="false" onAction="#payFineNowButton" prefHeight="26.0" prefWidth="148.0" text="Pay Now" />
      <Button layoutX="221.0" layoutY="665.0" mnemonicParsing="false" onAction="#generateFineReceiptButton" prefHeight="26.0" prefWidth="173.0" text="Generate Fine Receipt" />
