<AnchorPane prefHeight="641.0" prefWidth="914.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="rukonuddinshourov.CreateNewAnnouncementViewController">
