<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="searchBookMainPAnel" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="rukonuddinshourov.SearchBookViewController">
   <children>
      <Label fx:id="searchbookLB" alignment="CENTER" layoutX="-2.0" layoutY="-1.0" prefHeight="58.0" prefWidth="600.0" style="-fx-background-color: teal;" text="Search Book ">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="14.0" layoutY="82.0" prefHeight="44.0" prefWidth="102.0" text="Author name " />
      <TextField fx:id="authorNameTF" layoutX="104.0" layoutY="92.0" />
      <Button layoutX="351.0" layoutY="90.0" mnemonicParsing="false" onAction="#searchOnActionButton" prefHeight="26.0" prefWidth="74.0" style="-fx-background-color: tan;" text="search">
         <font>
            <Font size="13.0" />
         </font>
      </Button>
      <Button layoutX="288.0" layoutY="342.0" mnemonicParsing="false" onAction="#clearOnActionButton" prefHeight="44.0" prefWidth="89.0" style="-fx-background-color: red;" text="Clear" />
      <Button layoutX="480.0" layoutY="342.0" mnemonicParsing="false" onAction="#backOnActionButton" prefHeight="44.0" prefWidth="73.0" style="-fx-background-color: cyan;" text="Back" />
      <TableView layoutX="27.0" layoutY="126.0" prefHeight="200.0" prefWidth="374.0">
        <columns>
          <TableColumn fx:id="bookidTC" prefWidth="75.0" text="Book Id" />
          <TableColumn fx:id="titleTC" prefWidth="75.0" text="Title" />
            <TableColumn fx:id="authorTC" prefWidth="75.0" text="Author" />
            <TableColumn fx:id="publisherTC" prefWidth="75.0" text="Publisher" />
            <TableColumn fx:id="availablityTC" prefWidth="75.0" text="Availablity" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
