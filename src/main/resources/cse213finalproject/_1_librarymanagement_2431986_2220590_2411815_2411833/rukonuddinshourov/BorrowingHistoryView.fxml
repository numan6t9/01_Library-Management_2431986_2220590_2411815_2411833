<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="borrowingHistoryMainPane" prefHeight="516.0" prefWidth="709.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="rukonuddinshourov.BorrowingHistoryViewController">
   <children>
      <Label fx:id="borrowingHistoryLB" alignment="CENTER" prefHeight="55.0" prefWidth="709.0" style="-fx-background-color: coral;" text="Borrowing History">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="14.0" layoutY="74.0" prefHeight="38.0" prefWidth="92.0" text="Search  Boook " />
      <Label layoutX="14.0" layoutY="119.0" prefHeight="38.0" prefWidth="92.0" text="Status" />
      <ComboBox fx:id="statusCB" layoutX="99.0" layoutY="126.0" prefWidth="150.0" />
      <TextField fx:id="bookSearchTF" layoutX="99.0" layoutY="85.0" />
      <Button alignment="CENTER" layoutX="386.0" layoutY="68.0" mnemonicParsing="false" onAction="#searchOnActionButton" style="-fx-background-color: gray;" text="Search">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button layoutX="496.0" layoutY="69.0" mnemonicParsing="false" onAction="#refreshOnActionButton" style="-fx-background-color: teal;" text="Refresh">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Line endX="485.0" endY="-1.52587890625E-5" layoutX="115.0" layoutY="200.0" startX="-114.99998474121094" startY="-1.52587890625E-5" />
      <TableView fx:id="borrowHistoryTableView" layoutX="14.0" layoutY="243.0" prefHeight="151.0" prefWidth="462.0">
        <columns>
          <TableColumn fx:id="bookIdTC" prefWidth="75.0" text=" Book ID" />
          <TableColumn fx:id="bookTitleTC" prefWidth="75.0" text=" Book Title" />
            <TableColumn fx:id="borrowTC" prefWidth="75.0" text="Borrow" />
            <TableColumn fx:id="dueDateTC" prefWidth="75.0" text=" Due " />
            <TableColumn fx:id="returnDateTC" prefWidth="75.0" text="Return " />
            <TableColumn fx:id="statusTC" prefWidth="75.0" text="Status" />
        </columns>
      </TableView>
      <Button layoutX="496.0" layoutY="433.0" mnemonicParsing="false" onAction="#printOnActionButton" prefHeight="38.0" prefWidth="80.0" style="-fx-background-color: olive;" text="Print">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Label layoutX="23.0" layoutY="214.0" text="Borrow History Table" />
      <Button layoutX="60.0" layoutY="427.0" mnemonicParsing="false" onAction="#backButtonOnAction" text="Back">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
